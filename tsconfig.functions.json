{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "netlify/functions",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["netlify/functions/**/*.ts"],
  "exclude": ["node_modules", "dist", "client", "server"]
}
